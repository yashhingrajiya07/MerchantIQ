{
  "name": "merchantiq",
  "version": "1.0.0",
  "private": true,
  "description": "MerchantIQ — AI-Powered Merchant Decision Simulator",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@merchantiq/api run dev",
    "dev:web": "npm --workspace=@merchantiq/web run dev",
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "seed": "node --import tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "concurrently": "^9.1.2",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
