# =============================================================================
# MerchantIQ — Environment Configuration Template
# All variables below are OPTIONAL. The application runs with zero configuration
# out-of-the-box using offline deterministic fallbacks and synthetic test ledgers.
# =============================================================================

# Server Configuration
# PORT: Optional. On Render, the runtime PORT is automatically provided (e.g., 10000).
# Local development fallback is 3001.
PORT=3001

# NODE_ENV: Optional. Set to "production" on Render / staging, "development" locally.
NODE_ENV=development

# Razorpay Sandbox Credentials (Optional)
# If left blank or containing sample keys, the application operates in authentic
# offline mock fixture mode with full webhook verification support.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=merchantiq_test_webhook_secret

# AI / LLM Configuration (Optional)
# If GEMINI_API_KEY or OPENAI_API_KEY is omitted, MerchantIQ automatically uses
# its built-in offline deterministic semantic NLP parser (Zero-Drift Safe Mode).
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=fallback

# SQLite Storage & Engine Metadata (Optional)
# Default is ./merchantiq.db relative to repository root.
DATABASE_FILE=./merchantiq.db
SIMULATION_ENGINE_VERSION=1.0.0
